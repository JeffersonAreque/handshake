# Copy to .env and fill in. Never commit .env.

# PayPal *sandbox* REST app credentials
# (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Storage: Turso (libsql). If either is missing, a local SQLite file in
# DATA_DIR is used instead. Use a separate Turso DB for local dev, not the
# one the live demo uses.
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# AI: gemini or mock (offline, deterministic). With gemini, GEMINI_API_KEY is
# required (aistudio.google.com/apikey); the server won't start without it.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# AI_MODEL=gemini-2.5-flash

# One-click demo: sandbox business account that receives "Try as client"
# payments, and an optional sandbox buyer login shown on demo checkout pages.
DEMO_PAYEE_EMAIL=
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# SEED_DEMO=false                   # skip seeding the read-only showcase

# Optional
# PORT=3000
# DATA_DIR=./data
# BASE_URL=http://localhost:3000   # on Render, RENDER_EXTERNAL_URL is used
# ALLOW_PRIVATE_URLS=true           # local dev only: lets the verifier open localhost URLs
