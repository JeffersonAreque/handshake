# Copy to .env and fill in. Never commit .env.

# PayPal *sandbox* REST app credentials
# (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# AI verifier: mock (offline) for now; gemini comes in slice 2
AI_PROVIDER=mock

# Optional
# PORT=3000
# DATA_DIR=./data
# BASE_URL=http://localhost:3000   # on Render, RENDER_EXTERNAL_URL is used
# ALLOW_PRIVATE_URLS=true           # local dev only: lets the verifier open localhost URLs
