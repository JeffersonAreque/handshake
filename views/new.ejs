<%- include('partials/head', { title }) %>
<div class="page-head">
  <div>
    <span class="eyebrow">Client</span>
    <h1>New milestone</h1>
    <p class="muted" style="margin:0">Describe the work, let the AI draft acceptance criteria, edit them, then fund with PayPal.</p>
  </div>
</div>
<% if (errors.length) { %>
  <div class="alert error" role="alert"><div><% errors.forEach(e => { %><div><%= e %></div><% }) %></div></div>
<% } %>
<form method="post" action="/milestones" class="card">
  <label class="field"><span>Title</span>
    <input name="title" required maxlength="120" value="<%= form.title || '' %>" placeholder="Landing page for my bakery">
  </label>
  <div class="form-row">
    <label class="field"><span>Amount (USD)</span>
      <input name="amount" required inputmode="decimal" value="<%= form.amount || '' %>">
    </label>
    <label class="field"><span>Freelancer’s PayPal email</span>
      <input name="payeeEmail" type="email" required value="<%= form.payeeEmail || '' %>" placeholder="freelancer@example.com">
      <span class="hint">A PayPal <b>sandbox business</b> account. Captured funds are paid to this account.</span>
    </label>
  </div>
  <label class="field"><span>Brief</span>
    <textarea id="brief" name="brief" rows="3" maxlength="2000" placeholder="A one-page website for my bakery “Pan de Casa” with our opening hours, a photo of our bread, a menu with prices and a contact form."><%= form.brief || '' %></textarea>
    <span class="hint">Plain language. What do you want delivered?</span>
  </label>
  <div class="ai-assist">
    <button class="btn btn-sm btn-primary" type="button" id="draft-btn">✨ Draft criteria with AI</button>
    <span id="draft-msg" role="status">Gemini turns your brief into criteria it can check from screenshots.</span>
  </div>
  <label class="field"><span>Acceptance criteria</span>
    <textarea id="criteria" name="criteria" rows="7" required placeholder="The page shows the bakery name and a photo of bread&#10;There is a contact form with name, email and message fields&#10;On mobile the layout fits the screen without horizontal scrolling"><%= form.criteria || '' %></textarea>
    <span class="hint">One per line. These are exactly what the verifier checks, so edit freely before funding.</span>
  </label>
  <label class="field"><span>Description <span class="muted">(optional)</span></span>
    <textarea name="description" rows="2" maxlength="2000"><%= form.description || '' %></textarea>
  </label>
  <button class="btn btn-primary btn-lg" type="submit">Create milestone</button>
</form>
<script>
  (function () {
    const btn = document.getElementById('draft-btn');
    const msg = document.getElementById('draft-msg');
    const brief = document.getElementById('brief');
    const criteria = document.getElementById('criteria');
    btn.addEventListener('click', async () => {
      if (brief.value.trim().length < 15) { msg.textContent = 'Write a sentence or two in the brief first.'; brief.focus(); return; }
      if (criteria.value.trim() && !confirm('Replace the current criteria with an AI draft?')) return;
      btn.disabled = true; msg.textContent = 'Drafting…';
      try {
        const r = await fetch('/api/draft-criteria', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ brief: brief.value }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.error || 'Could not draft criteria.');
        criteria.value = d.criteria.join('\n');
        msg.textContent = 'Drafted by ' + d.model + '. Review and edit them below.';
        criteria.focus();
      } catch (e) { msg.textContent = e.message; } finally { btn.disabled = false; }
    });
  })();
</script>
<%- include('partials/foot') %>
