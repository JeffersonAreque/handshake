{
  "name": "handshake",
  "version": "0.1.0",
  "private": true,
  "description": "Milestone escrow where an AI agent verifies delivery before PayPal releases funds",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "spike": "node --env-file-if-exists=.env scripts/paypal-spike.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@libsql/client": "^0.18.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "playwright": "1.64.1"
  }
}
